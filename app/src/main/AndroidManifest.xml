<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by CleverTap for network delivery. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HostApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiSDK">

        <!--
          CleverTap ACCOUNT A, the host / recharge app.

          These meta-data keys configure CleverTap's DEFAULT instance, which is
          what CleverTapAPI.getDefaultInstance(context) returns. They belong to
          the host app and only the host app.

          The OTT SDK deliberately declares NONE of these in its own manifest;
          Account B is configured in code with CleverTapInstanceConfig. If the
          OTT SDK had declared them too, the manifest merger would either fail on
          the conflict or one account would silently win, which is exactly the
          failure mode this project exists to rule out.

          Values are injected from gradle.properties via manifestPlaceholders.
          A blank CLEVERTAP_REGION is ignored by the SDK (it falls back to its
          default domain), so leaving the placeholder empty is safe.
        -->
        <meta-data
            android:name="CLEVERTAP_ACCOUNT_ID"
            android:value="${clevertapAccountIdA}" />
        <meta-data
            android:name="CLEVERTAP_TOKEN"
            android:value="${clevertapTokenA}" />
        <meta-data
            android:name="CLEVERTAP_REGION"
            android:value="${clevertapRegionA}" />

        <!--
          Keeps the PoC free of the Google Advertising ID dependency. "0" tells
          CleverTap not to collect the ad id. This is a host-app (Account A)
          setting only and has no bearing on instance isolation.
        -->
        <meta-data
            android:name="CLEVERTAP_USE_GOOGLE_AD_ID"
            android:value="0" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          NOTE: OttActivity is NOT declared here. It comes from the OTT SDK's own
          AndroidManifest.xml via Android's manifest merger. Same for every
          CleverTap component (InAppNotificationActivity, CTInboxActivity,
          CTPushNotificationReceiver, CTFirebaseMessagingReceiver,
          CleverTapFileProvider), which the CleverTap AAR contributes once.
          Run  ./gradlew :app:processDebugMainManifest  and inspect
          app/build/intermediates/merged_manifests/  to see the merged result.
        -->

    </application>

</manifest>
